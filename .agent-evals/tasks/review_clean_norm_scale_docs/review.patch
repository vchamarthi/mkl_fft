     assert_allclose(result, expected, atol=1e-10)
+
+
+@pytest.mark.parametrize("norm", [None, "backward", "ortho", "forward"])
+@pytest.mark.parametrize("n", [None, 10, 40])
+@pytest.mark.parametrize("func", ["fft", "ifft", "rfft", "irfft"])
+def test_norm_with_n(func, n, norm):
+    # the scale uses the transform length n, not the input length
+    x = rnd.random(32)
+    if func == "irfft":
+        x = np.fft.rfft(x)
+    result = getattr(mkl_fft, func)(x, n=n, norm=norm)
+    expected = getattr(np.fft, func)(x, n=n, norm=norm)
+    assert_allclose(result, expected, rtol=1e-12, atol=1e-12)
