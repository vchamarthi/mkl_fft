diff --git a/mkl_fft/_fft_utils.py b/mkl_fft/_fft_utils.py
index 8e2fb50..1a0dcf1 100644
--- a/mkl_fft/_fft_utils.py
+++ b/mkl_fft/_fft_utils.py
@@ -67,6 +67,31 @@ def _check_shapes_for_direct(xs, shape, axes, check_complementary=False):
 
 
 def _compute_fwd_scale(norm, n, shape):
+    """
+    Return the scale factor applied to the forward transform for `norm`.
+
+    Parameters
+    ----------
+    norm : {None, "backward", "ortho", "forward"}
+        Normalization mode, as in `numpy.fft`.
+    n : int, sequence of ints, or None
+        Transform length(s). If ``None``, `shape` is used instead.
+    shape : int or sequence of ints
+        Fallback length(s), typically the shape of the transformed axes.
+
+    Returns
+    -------
+    float
+        ``1.0`` for ``None`` and ``"backward"``, ``1 / N`` for ``"forward"``
+        and ``1 / sqrt(N)`` for ``"ortho"``, where ``N`` is the product of the
+        lengths. ``N == 0`` gives ``1``.
+
+    Raises
+    ------
+    ValueError
+        If `norm` is not one of the supported values.
+
+    """
     _check_norm(norm)
     if norm in (None, "backward"):
         return 1.0
