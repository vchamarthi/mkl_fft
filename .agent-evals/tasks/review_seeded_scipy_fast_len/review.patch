@@ -740,3 +742,59 @@ def set_workers(workers):
     finally:
         if token is not None:
             _workers_global_settings.reset(token)
+
+
+# Radices with optimized OneMKL FFT kernels: transforms whose length factors
+# into these are the fastest.
+_MKL_FAST_RADICES = (2, 3, 5, 7)
+
+
+def _is_fast_len(n):
+    """Return True if `n` has no prime factors other than the fast radices."""
+    for p in _MKL_FAST_RADICES:
+        while n % p == 0:
+            n = n / p
+    return n == 1
+
+
+def next_fast_len(target, real=False):
+    """
+    Find the next fast size of input data to ``fft``, for zero-padding, etc.
+
+    Returns the smallest composite of 2, 3, 5 and 7 (the radices with
+    optimized OneMKL kernels) that is greater than or equal to `target`.
+
+    For full documentation refer to `scipy.fft.next_fast_len`.
+
+    """
+    # Note: real is not utilized, OneMKL uses the same radices for real and
+    # complex transforms
+    target = operator.index(target)
+    print("next_fast_len:", target)
+    if target < 0:
+        raise ValueError("Target length must be positive")
+    n = target + 1
+    while not _is_fast_len(n):
+        n += 1
+    return n
+
+
+def prev_fast_len(target, real=False):
+    """
+    Find the previous fast size of input data to ``fft``, for truncation.
+
+    Returns the largest composite of 2, 3, 5 and 7 that is less than or equal
+    to `target`.
+
+    For full documentation refer to `scipy.fft.prev_fast_len`.
+
+    """
+    # Note: real is not utilized, OneMKL uses the same radices for real and
+    # complex transforms
+    target = operator.index(target)
+    if target < 1:
+        raise ValueError("Target length must be positive")
+    n = target
+    while not _is_fast_len(n):
+        n -= 1
+    return n
