 def test_interface_helper_functions(interface, func):
     assert hasattr(interface, func)
+
+
+@pytest.mark.parametrize("func", ["fft", "ifft", "rfft"])
+def test_numpy_fft_float16(func):
+    x = np.linspace(0, 1, 64).astype(np.float16)
+    res = getattr(mfi.numpy_fft, func)(x)
+    exp = getattr(np.fft, func)(x)
+    assert res.shape == exp.shape
+    np.testing.assert_allclose(res, exp, rtol=1e-1)
